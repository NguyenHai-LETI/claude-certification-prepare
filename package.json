{
  "name": "claude-cert-trainer",
  "private": true,
  "version": "0.1.0",
  "description": "Local practice app for the Claude certification exams (CCAR-F, CCDV-F, CCAO-F, CCAR-P): YAML question bank, JSON results, local Claude Code AI, git sync, ngrok access.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node scripts/run.ts",
    "server": "node server/index.ts",
    "dev": "node --watch-path=server --watch-path=shared server/index.ts --dev",
    "build": "vite build",
    "public": "node scripts/public.ts",
    "validate": "node scripts/validate.ts",
    "import-ccx": "node scripts/import-ccx.ts",
    "import-txt": "node scripts/import-txt.ts",
    "sync": "node scripts/sync.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/*.test.ts\"",
    "test:ui": "node tests/ui/smoke.mjs",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
